{% extends 'base.html.twig' %}

{% block title %}Замовлення #{{ order.id }}: {{ order.name }} — SplitPay{% endblock %}

{% block body %}
<div class="mb-3">
    <a href="{{ path('web_dashboard') }}" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Назад до списку замовлень
    </a>
</div>

{% set percent = (order.fullPriceCents > 0) ? ((order.paidPriceCents / order.fullPriceCents) * 100)|round : 0 %}
{% set remainingDollars = order.remainingCents / 100 %}

<div class="row g-4 mb-4">
    {# Ліва колонка: Інформація про замовлення та історія платежів #}
    <div class="col-lg-7">
        {# Картка замовлення #}
        <div class="card shadow-sm mb-4">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <div>
                    <span class="mono text-muted small me-2">#{{ order.id }}</span>
                    <span class="h5 mb-0 fw-bold">{{ order.name }}</span>
                </div>
                <div>
                    {% if order.status.value == 'paid' %}
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fs-6">
                            <i class="bi bi-check-circle-fill me-1"></i> ОПЛАЧЕНО (PAID)
                        </span>
                    {% else %}
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2 fs-6">
                            <i class="bi bi-hourglass-split me-1"></i> ВІДКРИТО (OPEN)
                        </span>
                    {% endif %}
                </div>
            </div>
            <div class="card-body">
                <div class="row g-3 mb-3">
                    <div class="col-sm-4 text-center border-end">
                        <div class="text-muted small">Повна сума</div>
                        <div class="h4 fw-bold mb-0 mono">${{ (order.fullPriceCents / 100)|number_format(2, '.', ' ') }}</div>
                    </div>
                    <div class="col-sm-4 text-center border-end">
                        <div class="text-muted small">Сплачено</div>
                        <div class="h4 fw-bold mb-0 mono text-success">${{ (order.paidPriceCents / 100)|number_format(2, '.', ' ') }}</div>
                    </div>
                    <div class="col-sm-4 text-center">
                        <div class="text-muted small">Залишок до оплати</div>
                        <div class="h4 fw-bold mb-0 mono {% if order.remainingCents > 0 %}text-primary{% else %}text-muted{% endif %}">
                            ${{ (order.remainingCents / 100)|number_format(2, '.', ' ') }}
                        </div>
                    </div>
                </div>

                {# Прогрес бар #}
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center small mb-1">
                        <span class="text-muted">Прогрес спліту</span>
                        <span class="fw-bold mono">{{ percent }}%</span>
                    </div>
                    <div class="progress" style="height: 12px;">
                        <div class="progress-bar {% if order.status.value == 'paid' %}bg-success{% else %}bg-primary{% endif %}" 
                             role="progressbar" 
                             style="width: {{ percent > 100 ? 100 : percent }}%;" 
                             aria-valuenow="{{ percent }}" 
                             aria-valuemin="0" 
                             aria-valuemax="100">
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-wrap justify-content-between text-muted small pt-2 border-top">
                    <div>
                        <i class="bi bi-person me-1"></i> Власник: <strong>{{ order.user ? order.user.name : 'Unknown' }}</strong>
                    </div>
                    <div>
                        <span class="mono">версія ORM: {{ order.version }}</span> &bull; 
                        створено {{ order.createdAt|date('d.m.Y H:i') }}
                    </div>
                </div>
            </div>
        </div>

        {# Список здійснених платежів #}
        <div class="card shadow-sm">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <span class="h6 mb-0 fw-semibold"><i class="bi bi-clock-history me-2 text-primary"></i>Історія платежів</span>
                <span class="badge bg-secondary-subtle text-dark border">{{ payments|length }} транзакцій</span>
            </div>
            <div class="card-body p-0">
                {% if payments is empty %}
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-credit-card-2-front display-6 d-block mb-2 text-black-50"></i>
                        За цим замовленням поки немає здійснених платежів.
                    </div>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">ID</th>
                                    <th>Платник</th>
                                    <th>Сума</th>
                                    <th>Метод</th>
                                    <th>Idempotency Key</th>
                                    <th class="text-end pe-3">Дата</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for p in payments %}
                                    <tr>
                                        <td class="ps-3 mono fw-semibold">#{{ p.id }}</td>
                                        <td>
                                            <span class="badge bg-light text-dark border">
                                                <i class="bi bi-person me-1"></i>{{ p.user ? p.user.name : 'Unknown' }}
                                            </span>
                                        </td>
                                        <td class="mono fw-bold text-success">+${{ (p.amountCents / 100)|number_format(2, '.', ' ') }}</td>
                                        <td>
                                            {% if p.paymentMethod.value == 'card' %}
                                                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                                                    <i class="bi bi-credit-card me-1"></i>Card
                                                </span>
                                            {% else %}
                                                <span class="badge bg-secondary-subtle text-dark border">
                                                    <i class="bi bi-cash me-1"></i>Cash
                                                </span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <span class="mono text-muted small" title="{{ p.idempotencyKey }}">
                                                {{ p.idempotencyKey|length > 20 ? (p.idempotencyKey|slice(0, 18) ~ '…') : p.idempotencyKey }}
                                            </span>
                                        </td>
                                        <td class="text-end pe-3 small text-muted">
                                            {{ p.createdAt|date('d.m.Y H:i:s') }}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    {# Права колонка: Форма внесення нового платежу #}
    <div class="col-lg-5">
        <div class="card shadow-sm sticky-top" style="top: 80px;">
            <div class="card-header py-3 bg-primary text-white">
                <span class="h6 mb-0 fw-bold"><i class="bi bi-plus-circle me-2"></i>Внести спліт-платіж</span>
            </div>
            <div class="card-body">
                {% if order.status.value == 'paid' %}
                    <div class="alert alert-success d-flex align-items-center mb-0" role="alert">
                        <i class="bi bi-check-circle-fill fs-3 me-3 text-success"></i>
                        <div>
                            <strong>Замовлення повністю оплачене!</strong>
                            <div class="small">Усі частки за сплітом успішно внесено. Прийом нових оплат закрито.</div>
                        </div>
                    </div>
                {% else %}
                    <form action="{{ path('web_order_pay', {id: order.id}) }}" method="POST" id="paymentForm">
                        {# Сума платежу #}
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label for="amountDollars" class="form-label mb-0 fw-semibold">Сума платежу ($)</label>
                                <span class="small text-muted">Макс: ${{ (order.remainingCents / 100)|number_format(2, '.', '') }}</span>
                            </div>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" 
                                       step="0.01" 
                                       min="0.01" 
                                       class="form-control mono fs-5 fw-bold" 
                                       id="amountDollars" 
                                       name="amount_dollars" 
                                       value="{{ (order.remainingCents / 100) > 10 ? 10.00 : (order.remainingCents / 100)|number_format(2, '.', '') }}" 
                                       required>
                            </div>
                            <div class="d-flex gap-1 mt-2">
                                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="document.getElementById('amountDollars').value = '10.00'">$10</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="document.getElementById('amountDollars').value = '25.00'">$25</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="document.getElementById('amountDollars').value = '50.00'">$50</button>
                                <button type="button" class="btn btn-outline-primary btn-sm ms-auto" onclick="document.getElementById('amountDollars').value = '{{ (order.remainingCents / 100)|number_format(2, '.', '') }}'">Увесь залишок</button>
                            </div>
                        </div>

                        {# Вибір користувача #}
                        <div class="mb-3">
                            <label for="userId" class="form-label fw-semibold">Платник (Користувач)</label>
                            {% if users is empty %}
                                <div class="alert alert-warning small py-2 mb-2">
                                    Немає користувачів. Спочатку створіть користувача через верхнє меню.
                                </div>
                            {% endif %}
                            <select class="form-select" id="userId" name="user_id" required>
                                {% for u in users %}
                                    <option value="{{ u.id }}">#{{ u.id }} &bull; {{ u.name }}</option>
                                {% endfor %}
                            </select>
                        </div>

                        {# Метод оплати #}
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Спосіб оплати</label>
                            <div class="d-flex gap-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="payment_method" id="methodCard" value="card" checked>
                                    <label class="form-check-label" for="methodCard">
                                        <i class="bi bi-credit-card me-1 text-primary"></i> Банківська картка
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="payment_method" id="methodCash" value="cash">
                                    <label class="form-check-label" for="methodCash">
                                        <i class="bi bi-cash me-1 text-success"></i> Готівка
                                    </label>
                                </div>
                            </div>
                        </div>

                        {# Стратегія конкурентності #}
                        <div class="mb-3">
                            <label for="strategySelect" class="form-label fw-semibold">
                                Стратегія синхронізації
                                <i class="bi bi-info-circle text-muted ms-1" data-bs-toggle="tooltip" title="Визначає механізм контролю конкурентності під час паралельних запитів"></i>
                            </label>
                            <select class="form-select font-monospace small" id="strategySelect" name="strategy" required>
                                {% for key, label in strategies %}
                                    <option value="{{ key }}" {% if key == 'atomic' %}selected{% endif %}>
                                        {{ label }}
                                    </option>
                                {% endfor %}
                            </select>
                            <div class="form-text small">
                                <strong>Atomic</strong> — атомарний SQL UPDATE WHERE; <strong>Pessimistic</strong> — SELECT FOR UPDATE; <strong>Baseline</strong> — демонстрація оверпейменту під час конкурентності.
                            </div>
                        </div>

                        {# Idempotency Key #}
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label for="idempotencyKey" class="form-label mb-0 fw-semibold">
                                    Idempotency Key (I5)
                                </label>
                                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" onclick="generateNewKey()">
                                    <i class="bi bi-arrow-repeat me-1"></i> Згенерувати новий
                                </button>
                            </div>
                            <input type="text" class="form-control mono small text-muted" id="idempotencyKey" name="idempotency_key" value="{{ defaultIdempotencyKey }}" required>
                            <div class="form-text small">
                                Захист від дублювання. Якщо надіслати повторно той самий ключ — повернеться помилка <code>409 Conflict</code>.
                            </div>
                        </div>

                        {# Кнопка відправки #}
                        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold" {% if users is empty %}disabled{% endif %}>
                            <i class="bi bi-check2-circle me-1"></i> Внести платіж
                        </button>
                    </form>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    function generateNewKey() {
        const randomHex = Array.from(crypto.getRandomValues(new Uint8Array(8)))
            .map(b => b.toString(16).padStart(2, '0')).join('');
        document.getElementById('idempotencyKey').value = 'splitpay-' + randomHex;
    }
</script>
{% endblock %}
